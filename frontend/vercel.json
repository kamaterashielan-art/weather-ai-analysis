{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {
    "REACT_APP_API_URL": "@react_app_api_url",
    "REACT_APP_SOCKET_URL": "@react_app_socket_url"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.weatherai.com/api/:path*"
    }
  ]
}
